<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets CI (adb shell) drive the app on an emulator. Guarded by DUMP, which only the
     shell and system hold, so no installed app can send these commands. Never part of a release build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.DebugCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>

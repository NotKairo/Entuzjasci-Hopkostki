# Plik dla LOKALNEGO panelu (npm run panel). Skopiuj jako .env. Pliku .env nigdy nie wrzucaj na GitHuba.
# Sam bot działa na Supabase — jego sekrety ustawiasz w Supabase, nie tutaj.

# To samo hasło, które wpisałeś jako sekret PANEL_PASSWORD w Supabase.
PANEL_PASSWORD=

# Adres bota na Supabase (projekt "Entuzjaści Hopkostki"). Zwykle nie trzeba zmieniać.
BOT_URL=https://ucjmbdogtzztrkorqzjq.supabase.co/functions/v1/hopkostki-bot

# Port panelu: http://localhost:3000
PANEL_PORT=3000
# 127.0.0.1 = panel dostępny tylko z tego komputera (zalecane).
PANEL_HOST=127.0.0.1

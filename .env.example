# Plik dla OPCJONALNEGO lokalnego wrappera na panel (npm run panel) — panel działa też bez tego,
# prosto pod adresem funkcji na Supabase (patrz README). Skopiuj jako .env. Pliku .env nigdy nie wrzucaj
# na GitHuba. Sam bot działa na Supabase — jego sekrety (w tym PANEL_PASSWORD) ustawiasz w Supabase, nie tutaj.
# Hasło panelu wpisujesz w przeglądarce po otwarciu strony — nie ma go w tym pliku.

# Adres bota na Supabase (projekt "Entuzjaści Hopkostki"). Zwykle nie trzeba zmieniać.
BOT_URL=https://ucjmbdogtzztrkorqzjq.supabase.co/functions/v1/hopkostki-bot

# Port panelu: http://localhost:3000
PANEL_PORT=3000
# 127.0.0.1 = panel dostępny tylko z tego komputera (zalecane).
PANEL_HOST=127.0.0.1

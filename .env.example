# Skopiuj ten plik jako .env i uzupełnij. Pliku .env NIGDY nie wrzucaj na GitHuba.

# Token bota z https://discord.com/developers/applications -> Twoja aplikacja -> Bot -> Reset Token
DISCORD_TOKEN=

# ID serwera Entuzjaści Hopkostki (PPM na ikonę serwera -> Kopiuj ID serwera; wymaga trybu dewelopera).
# Komendy rejestrują się wtedy natychmiast i bot działa tylko na tym serwerze.
GUILD_ID=

# Panel konfiguracyjny
PANEL_PORT=3000
# 127.0.0.1 = panel dostępny tylko z tego komputera (zalecane).
PANEL_HOST=127.0.0.1
# Opcjonalne hasło do panelu (wymagane, jeśli zmienisz PANEL_HOST na 0.0.0.0).
PANEL_PASSWORD=
